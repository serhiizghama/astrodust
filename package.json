{
  "name": "astrodust",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/run.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/tests.mjs --log-level=error && node node_modules/.tmp/tests.mjs",
    "bench": "esbuild tests/bench-render.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/bench.mjs --log-level=error && node node_modules/.tmp/bench.mjs",
    "shot": "esbuild tests/shot.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/shot.mjs --log-level=error && node node_modules/.tmp/shot.mjs",
    "verify:audio": "esbuild tests/audio-scene.ts --bundle --format=iife --global-name=AudioScene --outfile=node_modules/.tmp/audio-scene.js --log-level=error && esbuild tests/audio-verify.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/audio-verify.mjs --log-level=error && node node_modules/.tmp/audio-verify.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,html}\""
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
